# Copy to .env in the working directory. It loads automatically; shell variables win.
# Set VISA_ENV_FILE to use another file. Never commit .env or credentials.
VISA_MODEL=deepseek-flash
VISA_BASE_URL=https://api.deepseek.com
# Send OCR text plus original images / rendered PDF pages. Set 0 for text-only comparison.
VISA_VISION=1
# Existing DEEPSEEK_API_KEY is supported. Otherwise set VISA_API_KEY.
VISA_API_KEY=
VISA_DATA_DIR=data
# Policy is bound at case creation. Restart + create/reset a case to change it.
VISA_HITL=off
VISA_QQ_DATA_DIR=data/qq-test
VISA_MAIL_INTERVAL=15
# Outlook pilot: own public-client app; login takes place on Microsoft's page.
VISA_MS_CLIENT_ID=
VISA_MS_TENANT=common
VISA_OUTLOOK_MAILBOX=
# Separate sender accounts, comma separated. Subject must include [VisaTest].
VISA_OUTLOOK_ALLOW_SENDERS=
# Optional USD prices per million tokens; blank means cost is unknown.
VISA_INPUT_USD_PER_MILLION=
VISA_OUTPUT_USD_PER_MILLION=
# Optional headless QQ connector; Windows setup defaults to encrypted persistence.
# Used with scripts/configure_qq.py --from-env; do not commit actual values.
VISA_QQ_MAILBOX=
VISA_QQ_AUTH_CODE=
VISA_QQ_ALLOWED_SENDERS=
# Setup defaults for configure_qq.py --from-env. Stored in qq-config.json afterwards.
VISA_QQ_ACCEPT_ALL=0
VISA_QQ_ALLOW_SAMPLES=0
