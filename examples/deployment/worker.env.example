# Copy to a PRIVATE environment file; never commit real values.
VISA_MODEL=deepseek-flash
VISA_BASE_URL=https://api.deepseek.com
VISA_VISION=1
VISA_API_KEY=replace-with-your-model-key
VISA_QQ_MAILBOX=123456@qq.com
VISA_QQ_AUTH_CODE=replace-with-qq-authorization-code
# New inboxes accept any customer address and subject.
VISA_QQ_ACCEPT_ALL=1
VISA_QQ_ALLOWED_SENDERS=
VISA_QQ_ALLOW_SAMPLES=0
VISA_HITL=off
VISA_MAIL_INTERVAL=15
